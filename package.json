{
  "name": "acai-do-dudu",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de PDV Açaí do Dudu",
  "author": "TECX SISTEMAS",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\"",
    "build:bot": "esbuild servidor.ts --bundle --platform=node --format=cjs --outfile=servidor.cjs --external:electron --external:path --external:fs --external:os --external:http",
    "electron:build": "npm run build:bot && vite build --base=./ && electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "@whiskeysockets/baileys": "^6.6.0",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
    "concurrently": "^8.2.2",
    "date-fns": "^3.3.1",
    "dotenv": "^16.4.5",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "firebase": "^10.8.0",
    "framer-motion": "^11.0.3",
    "intro.js": "^7.2.0",
    "lucide-react": "^0.330.0",
    "openai": "^4.28.0",
    "pino": "^8.19.0",
    "qrcode-terminal": "^0.12.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-confetti": "^6.1.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^31.7.7",
    "electron-builder": "^26.4.0",
    "postcss": "^8.4.35",
    "supabase": "^2.95.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.0",
    "vite-plugin-pwa": "^0.19.0"
  },
  "build": {
    "appId": "com.acaidodudu.pdv",
    "productName": "Açaí do Dudu PDV",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MANINtecn",
        "repo": "acaidodudu"
      }
    ],
    "extraResources": [
      "printer_raw.ps1"
    ],
    "files": [
      "dist/**/*",
      "build/**/*",
      ".env",
      "main.js",
      "preload.cjs",
      "servidor.cjs",
      "servidor.js",
      "package.json",
      "resources/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
