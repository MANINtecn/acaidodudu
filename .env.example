VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Bot WhatsApp / Electron (servidor.ts e main.js) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORE_ID=
OPENAI_API_KEY=
BTZAP_TOKEN=
