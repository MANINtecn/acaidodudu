# ============================================================
# Açaí do Dudu — Variáveis de ambiente
# Copie este arquivo para .env (bot/Electron) e .env.local (frontend Vite)
# e preencha com as credenciais do NOVO banco quando ele for criado.
# ============================================================

# --- Frontend (Vite) — precisa do prefixo VITE_ ---
VITE_SUPABASE_URL=
